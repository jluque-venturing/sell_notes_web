# ============================================================
#  Copiá este archivo como .env.local y completá los valores.
#  Las MISMAS variables hay que cargarlas en Vercel
#  (Project Settings -> Environment Variables).
# ============================================================


# --- Frontend (van al navegador, se ven en el bundle) --------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Freno para que no cualquiera pueda llamar a /api. Tiene que ser
# igual que APP_SECRET. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
VITE_APP_SECRET=


# --- Servidor (solo Vercel, nunca llegan al navegador) -------
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_SECRET=

# Bot de Telegram (@BotFather)
TELEGRAM_TOKEN=
# Uno o varios chat_id separados por coma
TELEGRAM_CHAT_IDS=

# Service Account de Google Cloud con permiso sobre el Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1f5B44xWbeJST7chHnSBDzwSfMi3Zuesv27efv2xveY8
# Opcional. Por defecto A:F (las 6 columnas de la primera hoja)
GOOGLE_SHEET_RANGE=A:F
